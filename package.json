{
  "name": "gtasks-cloudrun",
  "version": "0.2.0",
  "description": "Google Tasks MCP-Server, lauffähig auf Cloud Run mit OAuth für die Claude-App",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/http.ts --outdir ./dist --target bun",
    "start": "bun run src/http.ts",
    "start:stdio": "bun run src/index.ts",
    "auth": "bun run src/index.ts auth",
    "test": "bun test"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.2.5",
    "typescript": "5"
  }
}
